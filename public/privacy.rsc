ll,{"children":"What we collect"}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","b",null,{"children":"From Google sign-in:"}]," your name, email address and profile photo. We never see your Google password."]}],["$","li",null,{"children":[["$","b",null,{"children":"When you register:"}]," your name, gender, college, enrolment or roll number and phone number, and a photo of the front of your college ID card that you upload."]}],["$","li",null,{"children":[["$","b",null,{"children":"For the fee:"}]," the UPI transaction ID (UTR) and the screenshot of your payment that you upload. We do not collect card, bank or UPI PIN details."]}],["$","li",null,{"children":[["$","b",null,{"children":"Referral codes:"}]," if you enter a friend's or a campus ambassador's code when you register, we record whose code it was."]}],["$","li",null,{"children":[["$","b",null,{"children":"Campus ambassadors:"}]," when you get an ambassador code, we store it with your name, college and Google email. What you fill in on our ambassador application form is kept by the organisers in Google Forms."]}],["$","li",null,{"children":[["$","b",null,{"children":"At the venue:"}]," when your entry pass is scanned, we record the time, the entry desk and which volunteer checked you in."]}],["$","li",null,{"children":[["$","b",null,{"children":"Visit statistics:"}]," anonymous page-view counts through Vercel Analytics, which uses no cookies and does not identify you."]}]]}],["$","h2",null,{"children":"Why we use it"}],["$","ul",null,{"children":[["$","li",null,{"children":"To sign you in and keep you signed in."}],["$","li",null,{"children":"To verify your payment and your college ID card, and confirm or reject your registration."}],["$","li",null,{"children":"To issue your QR entry pass and check you in at the gate, once per registration."}],["$","li",null,{"children":"To contact you about your registration or important changes to the fest."}],["$","li",null,{"children":"To keep the site secure and stop abuse, such as fake or repeated registrations."}]]}],["$","p",null,{"children":"We do not sell your data, use it for advertising or send you marketing email."}],"$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f"]}]]}],"$L20"]}]]}],["$L21"],"$L22"]}]
