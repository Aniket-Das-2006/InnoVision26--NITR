10:["$","ul",null,{"children":[["$","li",null,{"children":[["$","b",null,{"children":"You"}]," can see your own profile, registration and entry pass after signing in."]}],["$","li",null,{"children":[["$","b",null,{"children":"The registration team"}]," sees registration details, payment screenshots and ID card photos to verify payments and identities. These files are kept in private storage and opened only through short-lived links."]}],["$","li",null,{"children":[["$","b",null,{"children":"Admins and the registration team"}]," also see which code each registrant entered, and each campus ambassador's name, email, phone number, college and the registrations their code brought in, to run the programme and contact them. Ambassadors see only their own code, never who used it."]}],["$","li",null,{"children":[["$","b",null,{"children":"Gate volunteers"}]," see your registration details and the ID card photo you uploaded when they scan your pass, to match them with your college ID."]}],["$","li",null,{"children":[["$","b",null,{"children":"Service providers"}]," that run the site for us: Google (sign-in, and Google Forms for ambassador applications), Supabase (database and file storage) and Vercel (hosting and visit statistics). They process data only to provide those services."]}]]}]
11:["$","p",null,{"children":"We share data with anyone else only if the law requires it."}]
12:["$","h2",null,{"children":"Cookies and browser storage"}]
13:["$","p",null,{"children":"We use two sign-in cookies, which last up to 7 and 30 days, so you stay logged in. The site also keeps small, temporary notes in your browser's session storage, for example to reopen the registration form after you sign in. If you open a share link that carries a referral code, the code is kept in your browser's local storage for up to 30 days, only to fill it in when you register. We use no advertising or tracking cookies."}]
14:["$","h2",null,{"children":"How long we keep it"}]
15:["$","p",null,{"children":"We keep registration data, payment screenshots, ID card photos and check-in records only for as long as we need them to run INNOVISION 2026, handle questions about payments or entry and settle the fest's accounts. After that we delete them."}]
16:["$","h2",null,{"children":"How we protect it"}]
17:["$","p",null,{"children":"Data is sent over encrypted connections. Access is limited by role: participants can read only their own records, and only the registration team can see payment screenshots and ID card photos. Entry-pass codes are stored encrypted. No system is perfectly secure, but we take reasonable steps to protect your data."}]
18:["$","h2",null,{"children":"Your choices and rights"}]
19:["$","ul",null,{"children":[["$","li",null,{"children":"You can view your details in your profile and update your phone number there."}],["$","li",null,{"children":"You can ask us for a copy of your data, to correct details you can't edit yourself, or to delete your data."}],["$","li",null,{"children":"If you have a concern about how we handle your data, contact us first and we will try to resolve it."}]]}]
1a:["$","p",null,{"children":"Deleting your data cancels your registration and entry pass. We may keep a record of a payment where that is needed to settle accounts or resolve a dispute."}]
1b:["$","h2",null,{"children":"Changes to this policy"}]
1c:["$","p",null,{"children":"If we change this policy we will update it on this page and change the date at the top. Significant changes will also be announced on the site."}]
1d:["$","h2",null,{"children":"Contact us"}]
1e:["$","p",null,{"children":"For any privacy question or request, contact the organising team:"}]
