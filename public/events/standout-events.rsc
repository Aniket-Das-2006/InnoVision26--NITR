23:["$","li","bff5cb2a-acb0-4d1f-83b1-0bc47a910252",{"children":["$","article",null,{"className":"EventsPage_card__wXJCT","children":[["$","img",null,{"className":"EventsPage_poster__Ydkgj","src":"https://ik.imagekit.io/b4kmkfgaod/innovision/events/event_design-dash_79212baa06a5.webp?tr=w-640","alt":"Design Dash poster","width":640,"height":800,"loading":"lazy","decoding":"async"}],["$","div",null,{"className":"EventsPage_cardBody__7bQFh","children":[["$","h3",null,{"className":"EventsPage_cardTitle__vXsoH","children":"Design Dash"}],["$","p",null,{"className":"EventsPage_cardText__v7bmu","children":"Design Dash is a fast-paced, four-stage design competition that challenges creativity, observation, problem-solving, and teamwork. Participants will race through activities including finding colour matches, navigating a design maze, solving scribble-based challenges, and building paper planes. Each round tests a different design skill, while speed and accuracy add to the excitement. The team with the best overall performance will emerge as the winner."}],["$","dl",null,{"className":"EventsPage_facts__7V_2e","children":[["$","div","FORMAT",{"style":{"display":"contents"},"children":[["$","dt",null,{"children":"FORMAT"}],["$","dd",null,{"children":"Solo / Team"}]]}],["$","div","DURATION",{"style":{"display":"contents"},"children":[["$","dt",null,{"children":"DURATION"}],["$","dd",null,{"children":"TBA"}]]}],["$","div","VENUE",{"style":{"display":"contents"},"children":[["$","dt",null,{"children":"VENUE"}],["$","dd",null,{"children":"NIT Rourkela"}]]}]]}]]}]]}]}]
24:["$","li","f9c8dc74-6bd0-48d8-b4e8-d517a16cbf99",{"children":["$","article",null,{"className":"EventsPage_card__wXJCT","children":[["$","img",null,{"className":"EventsPage_poster__Ydkgj","src":"https://ik.imagekit.io/b4kmkfgaod/innovision/events/event_cosmic-brawl_5fb62d753fdb.webp?tr=w-640","alt":"Cosmic Brawl poster","width":640,"height":800,"loading":"lazy","decoding":"async"}],["$","div",null,{"className":"EventsPage_cardBody__7bQFh","children":[["$","h3",null,{"className":"EventsPage_cardTitle__vXsoH","children":"Cosmic Brawl"}],["$","p",null,{"className":"EventsPage_cardText__v7bmu","children":"Cosmic Brawl is an action-packed gaming event bringing together immersive VR combat and high-speed racing under one roof. Participants can step into the arena with Cosmic Brawl VR, battling opponents in an exciting virtual experience, or take on Veloche V2, testing their speed, precision, and racing skills. Get ready for an adrenaline-filled gaming experience!"}],["$","dl",null,{"className":"EventsPage_facts__7V_2e","children":[["$","div","FORMAT",{"style":{"display":"contents"},"children":[["$","dt",null,{"children":"FORMAT"}],["$","dd",null,{"children":"Solo / Team"}]]}],["$","div","DURATION",{"style":{"display":"contents"},"children":[["$","dt",null,{"children":"DURATION"}],["$","dd",null,{"children":"TBA"}]]}],["$","div","VENUE",{"style":{"display":"contents"},"children":[["$","dt",null,{"children":"VENUE"}],["$","dd",null,{"children":"NIT Rourkela"}]]}]]}]]}]]}]}]
25:["$","li","e03bed13-4030-48ba-b428-456019477e70",{"children":["$","article",null,{"className":"EventsPage_card__wXJCT","children":[["$","img",null,{"className":"EventsPage_poster__Ydkgj","src":"https://ik.imagekit.io/b4kmkfgaod/innovision/events/event_spancraft_f30c3c2e6c41.webp?tr=w-640","alt":"Spancraft poster","width":640,"height":800,"loading":"lazy","decoding":"async"}],["$","div",null,{"className":"EventsPage_cardBody__7bQFh","children":[["$","h3",null,{"className":"EventsPage_cardTitle__vXsoH","children":"Spancraft"}],["$","p",null,{"className":"EventsPage_cardText__v7bmu","children":"SpanCraft is a bridge-building challenge where participants must design and construct a cable-stayed bridge along with its foundation under fixed material and budget constraints.\r\n \r\n Each team will receive a fixed initial budget to purchase foundation materials. Sand will be cheaper, while soil will be costlier but provide better foundation performance, forcing teams to make strategic decisions between cost and stability.\r\n \r\n For the bridge, teams will be provided with long wooden members and other specified materials. The completed bridge must satisfy the given dimensional requirements and will then be tested for its maximum load-bearing capacity.\r\n \r\n The winner will be the team that achieves the best combination of load capacity, dimensional accuracy and cost efficiency."}],["$","dl",null,{"className":"EventsPage_facts__7V_2e","children":[["$","div","FORMAT",{"style":{"display":"contents"},"children":[["$","dt",null,{"children":"FORMAT"}],["$","dd",null,{"children":"Solo / Team"}]]}],["$","div","DURATION",{"style":{"display":"contents"},"children":[["$","dt",null,{"children":"DURATION"}],["$","dd",null,{"children":"TBA"}]]}],["$","div","VENUE",{"style":{"display":"contents"},"children":[["$","dt",null,{"children":"VENUE"}],["$","dd",null,{"children":"NIT Rourkela"}]]}]]}]]}]]}]}]
26:["$","li","0d8f83b5-11f7-4d51-be32-cc66e4eea968",{"children":["$","article",null,{"className":"EventsPage_card__wXJCT","children":[["$","img",null,{"className":"EventsPage_poster__Ydkgj","src":"https://ik.imagekit.io/b4kmkfgaod/innovision/events/event_car-show_80729634fbea.webp?tr=w-640","alt":"Car Show poster","width":640,"height":800,"loading":"lazy","decoding":"async"}],["$","div",null,{"className":"EventsPage_cardBody__7bQFh","children":[["$","h3",null,{"className":"EventsPage_cardTitle__vXsoH","children":"Car Show"}],["$","p",null,{"className":"EventsPage_cardText__v7bmu","children":"The Car Show is an interactive automotive exhibition and engineering showcase organized by Team Black Mamba Racing Electric during INNOVISION. The event features a display of student-designed competition vehicles, allowing attendees to closely examine key subsystems such as the chassis, suspension, powertrain, and electrical architectures while engaging with team members. Additionally, the vehicles of SAE NIT Rourkela will be running in the campus, providing live demonstrations of their performance and engineering capabilities"}],["$","dl",null,{"className":"EventsPage_facts__7V_2e","children":[["$","div","FORMAT",{"style":{"display":"contents"},"children":[["$","dt",null,{"children":"FORMAT"}],["$","dd",null,{"children":"Solo / Team"}]]}],["$","div","DURATION",{"style":{"display":"contents"},"children":[["$","dt",null,{"children":"DURATION"}],["$","dd",null,{"children":"TBA"}]]}],["$","div","VENUE",{"style":{"display":"contents"},"children":[["$","dt",null,{"children":"VENUE"}],["$","dd",null,{"children":"NIT Rourkela"}]]}]]}]]}]]}]}]
27:["$","li","280b0bdf-de22-41cf-8b44-58189a6b85ca",{"children":["$","article",null,{"className":"EventsPage_card__wXJCT","children":[["$","img",null,{"className":"EventsPage_poster__Ydkgj","src":"https://ik.imagekit.io/b4kmkfgaod/innovision/events/event_the-missing-ceo_8ae65c6f551c.webp?tr=w-640","alt":"The Missing CEO poster","width":640,"height":800,"loading":"lazy","decoding":"async"}],["$","div",null,{"className":"EventsPage_cardBody__7bQFh","children":[["$","h3",null,{"className":"EventsPage_cardTitle__vXsoH","children":"The Missing CEO"}],["$","p",null,{"className":"EventsPage_cardText__v7bmu","children":"The Missing CEO is a business-focused corporate investigation and case-solving challenge where participants act as a review panel to uncover how organizational failures allowed a critical issue to remain hidden. Teams analyse fragmented information, question stakeholders, identify red flags, and connect evidence to diagnose failures in corporate governance, internal controls, reporting, and escalation mechanisms. The event tests strategic thinking, teamwork, analytical reasoning, and business decision-making"}],["$","dl",null,{"className":"EventsPage_facts__7V_2e","children":[["$","div","FORMAT",{"style":{"display":"contents"},"children":[["$","dt",null,{"children":"FORMAT"}],["$","dd",null,{"children":"Solo / Team"}]]}],["$","div","DURATION",{"style":{"display":"contents"},"children":[["$","dt",null,{"children":"DURATION"}],["$","dd",null,{"children":"TBA"}]]}],["$","div","VENUE",{"style":{"display":"contents"},"children":[["$","dt",null,{"children":"VENUE"}],["$","dd",null,{"children":"NIT Rourkela"}]]}]]}]]}]]}]}]
28:["$","li","a47c4954-281c-4f7e-995f-cff6337abc62",{"children":["$","article",null,{"className":"EventsPage_card__wXJCT","children":[["$","img",null,{"className":"EventsPage_poster__Ydkgj","src":"https://ik.imagekit.io/b4kmkfgaod/innovision/events/event_roadies-the-food-saga-4-0_d3b708ea5263.webp?tr=w-640","alt":"Roadies: The Food Saga 4.0 poster","width":640,"height":800,"loading":"lazy","decoding":"async"}],["$","div",null,{"className":"EventsPage_cardBody__7bQFh","children":[["$","h3",null,{"className":"EventsPage_cardTitle__vXsoH","children":"Roadies: The Food Saga 4.0"}],["$","p",null,{"className":"EventsPage_cardText__v7bmu","children":"In Innovision 2026, our club FTS will be hosting an event\r\n titled Roadies: The Food Saga 4.0. The event will\r\n consist of three exciting rounds designed to showcase our\r\n passion for Food Technology while blending it with fun\r\n and creativity.\r\n Round-1\r\n In the first round, participants will be grouped as per the\r\n set limit and provided with a Dalgona cookie. They will\r\n be required to carve it into a specific shape within a given\r\n time limit.\r\n Round-2\r\n Participants who fail to complete the task will be\r\n eliminated and will not qualify for the second round,\r\n which will feature a rapid-fire quiz on topics related to\r\n food safety, nutrition, and technology. \r\n Round-3\r\n The final round will feature blindfolded participants who\r\n must identify different food items using their senses. This\r\n round highlights the importance of sensory analysis in\r\n making food more appealing to consumers."}],["$","dl",null,{"className":"EventsPage_facts__7V_2e","children":[["$","div","FORMAT",{"style":{"display":"contents"},"children":[["$","dt",null,{"children":"FORMAT"}],["$","dd",null,{"children":"Solo / Team"}]]}],["$","div","DURATION",{"style":{"display":"contents"},"children":[["$","dt",null,{"children":"DURATION"}],["$","dd",null,{"children":"TBA"}]]}],["$","div","VENUE",{"style":{"display":"contents"},"children":[["$","dt",null,{"children":"VENUE"}],["$","dd",null,{"children":"NIT Rourkela"}]]}]]}]]}]]}]}]
29:["$","li","c5d5a48b-c66a-443d-90fd-1dad3629318c",{"children":["$","article",null,{"className":"EventsPage_card__wXJCT","children":[["$","img",null,{"className":"EventsPage_poster__Ydkgj","src":"https://ik.imagekit.io/b4kmkfgaod/innovision/events/event_1791548491176_An_AI-Powered_HacKATHON__1__-_Amiya_OfR10gNJc.webp?tr=w-640","alt":"VibeNova poster","width":640,"height":800,"loading":"lazy","decoding":"async"}],["$","div",null,{"className":"EventsPage_cardBody__7bQFh","children":[["$","h3",null,{"className":"EventsPage_cardTitle__vXsoH","children":"VibeNova"}],["$","p",null,{"className":"EventsPage_cardText__v7bmu","children":"VibeNovais an AI-assisted coding competition where participants use a designated chatbot and a strictly limited number of prompts to build a target implementation. The challenge tests strategic prompting, requirement understanding, debugging, and practical AI-assisted development. Participants must submit a GitHub repository and present their solution to judges. The winner is determined by functional accuracy, requirement matching, visual similarity, behaviour, presentation, and repository integrity."}],["$","dl",null,{"className":"EventsPage_facts__7V_2e","children":[["$","div","FORMAT",{"style":{"display":"contents"},"children":[["$","dt",null,{"children":"FORMAT"}],["$","dd",null,{"children":"Solo / Team"}]]}],["$","div","DURATION",{"style":{"display":"contents"},"children":[["$","dt",null,{"children":"DURATION"}],["$","dd",null,{"children":"TBA"}]]}],["$","div","VENUE",{"style":{"display":"contents"},"children":[["$","dt",null,{"children":"VENUE"}],["$","dd",null,{"children":"NIT Rourkela"}]]}]]}]]}]]}]}]
